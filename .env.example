# 第一版直连 Anthropic API。上线前改为指向自建中继（见 relay/README.md）——
# 密钥不能放在教师机器上，这是 docs/architecture.md §8.3 的硬要求。
ANTHROPIC_API_KEY=sk-ant-...

# 中继就绪后改成这两行，客户端不再持有真实密钥：
# ANTHROPIC_BASE_URL=https://relay.example.com
# ANTHROPIC_AUTH_TOKEN=<教师短期 token>
#
# 走兼容网关时：ANTHROPIC_BASE_URL 不要带 /v1，SDK 自己会拼 /v1/messages。

# 文本模型别名。设置界面优先；没配设置时读这一行。
# MTC_MODEL=claude-sonnet-4-20250514

# 情境插图用的生图模型别名（可选）。不填就用 illustration.py 里的默认值。
# 网关上有哪些图模型：GET <BASE_URL>/v1/images/generations
# 注意它和 MTC_MODEL 是两套名字，文本模型别名打图接口只会 400。
# MTC_IMAGE_MODEL=codex/gpt-5.6-luna

# 调试 Python 工具进程时打开。wait 会在第一行断住，同时把 MCP_TIMEOUT 调大。
# MTC_DEBUGPY=1
# MCP_TIMEOUT=600000
